#!/usr/bin/env bash
# DeepShift Suite Loader (Zsh & Bash Compatible)

# 🛡️ Guard: Prevent double-loading
if [[ -n "$LOADER_DEEPSHIFT_87EDB077_LOADED" ]]; then
  return 0
fi
export LOADER_DEEPSHIFT_87EDB077_LOADED=1

# 📍 1. Identify Root Directory (Shell-Agnostic)
# Bash uses BASH_SOURCE, Zsh uses (%):-%x
local _current_source="${BASH_SOURCE[0]:-${(%):-%x}}"
export DEEPSHIFT_ROOT_DIR="$(cd "$(dirname "$_current_source")" &>/dev/null && pwd)"

# 🚀 2. Source Tool Wrappers
# We use the exported Root Dir to find files in the /src/ hierarchy
[[ -f "$DEEPSHIFT_ROOT_DIR/src/deepShift/deepShift.sh" ]] && source "$DEEPSHIFT_ROOT_DIR/src/deepShift/deepShift.sh"
[[ -f "$DEEPSHIFT_ROOT_DIR/src/codeShift/codeShift.sh" ]] && source "$DEEPSHIFT_ROOT_DIR/src/codeShift/codeShift.sh"
[[ -f "$DEEPSHIFT_ROOT_DIR/src/dirShift/dirShift.sh" ]] && source "$DEEPSHIFT_ROOT_DIR/src/dirShift/dirShift.sh"

# 🔧 3. Source Utilities
[[ -f "$DEEPSHIFT_ROOT_DIR/utils/deepShiftIsPathIgnored.sh" ]] && source "$DEEPSHIFT_ROOT_DIR/utils/deepShiftIsPathIgnored.sh"

# 🧪 4. Source Test Entry Point
[[ -f "$DEEPSHIFT_ROOT_DIR/test/testCodeShiftAll.sh" ]] && source "$DEEPSHIFT_ROOT_DIR/test/testCodeShiftAll.sh"

if [[ -n "$ZSH_VERSION" ]]; then
    # Zsh specific: ensure aliases are expanded in scripts if needed
    # setopt aliases
    echo "🚀 DeepShift Loaded (Zsh Mode)"
else
    echo "🚀 DeepShift Loaded (Bash Mode)"
fi
